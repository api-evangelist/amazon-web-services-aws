  "info": {
    "_postman_id": "b4df943c-3aaa-4024-9134-d503de847a01",
    "name": "Amazon EC2 API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Amazon Elastic Compute Cloud (EC2) Query API for managing virtual\nmachines, EBS volumes, security groups, key pairs, AMIs, VPCs,\nsubnets, and related infrastructure. All operations are invoked\nby POSTing form-encoded `Action=<Name>&Version=2016-11-15` to the\nregional endpoint, signed with AWS Signature Version 4 (SigV4),\nand return XML responses.\n\n\nContact Support:\n Name: Amazon Web Services",
      "type": "text/plain"
    }
  }
